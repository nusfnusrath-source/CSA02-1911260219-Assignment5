### B1.4 – Find the Limit (2 Marks)

Linear recursion creates many function calls and uses more stack memory. For very large values of n, it may crash due to stack overflow.

The iterative version uses a loop instead of recursive calls. It uses less stack memory and can handle larger values.

CODE:

#include <stdio.h>

long long calls = 0;

int digitalRoot(int n)
{
    if (n < 10)
        return n;

    int sum = 0;
    while (n > 0)
    {
        sum += n % 10;
        n /= 10;
    }

    return digitalRoot(sum);
}

long long power_linear(long long base, int exp)
{
    calls++;

    if (exp == 0)
        return 1;

    return base * power_linear(base, exp - 1);
}

long long power_fast(long long base, int exp)
{
    calls++;

    if (exp == 0)
        return 1;

    long long half = power_fast(base, exp / 2);

    if (exp % 2 == 0)
        return half * half;
    else
        return base * half * half;
}

int main(void)
{
    printf("Digital root of 9875 = %d\n", digitalRoot(9875));
    printf("Digital root of 0 = %d\n", digitalRoot(0));

    calls = 0;
    long long a = power_linear(2, 30);
    printf("Linear: %lld in %lld calls\n", a, calls);

    calls = 0;
    long long b = power_fast(2, 30);
    printf("Fast: %lld in %lld calls\n", b, calls);

    return 0;
}

